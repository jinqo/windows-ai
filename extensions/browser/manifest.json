{
  "manifest_version": 3,
  "name": "Windows AI",
  "version": "0.1.2",
  "description": "Send selected text or the current page to the Windows AI desktop assistant.",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Windows AI",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icon32.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "32": "icon32.png",
    "128": "icon128.png"
  },
  "commands": {
    "ask-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Ask Windows AI about the selection"
    }
  }
}
