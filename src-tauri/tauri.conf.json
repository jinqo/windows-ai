{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Windows AI",
  "version": "0.1.3",
  "identifier": "com.windowsai.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run build:shell",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Windows AI",
        "url": "index.html",
        "width": 860,
        "height": 640,
        "minWidth": 420,
        "minHeight": 360,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "visible": false,
        "resizable": true,
        "center": true
      },
      {
        "label": "toolbar",
        "title": "Windows AI Toolbar",
        "url": "index.html?window=toolbar",
        "width": 520,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Windows AI assistant overlay",
    "longDescription": "Windows AI is a desktop AI assistant for Windows 11 with a floating overlay, local memory, permission-checked tools, MCP, voice and app integrations.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "resources": {
      "../shell-ext/bin/windows_ai_shell.dll": "windows_ai_shell.dll"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2Q0RBRDlGNjczOUZBNjIKUldSaStqbG5uNjNOaG5SckU3eDUxOFVQMitwVE9sUllzV3lIVC9NQStRZm16UTVBQ1N2aGwxcmYK",
      "endpoints": [
        "https://github.com/jinqo/windows-ai/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
